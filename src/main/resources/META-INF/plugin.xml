    <action id="scan-repository" class="net.nightvision.plugin.actions.ScanRepositoryAction" text="(NV) Scan Repository">
      <add-to-group group-id="ToolsMenu" anchor="first"></add-to-group>
    </action>
  </actions> -->
</idea-plugin>